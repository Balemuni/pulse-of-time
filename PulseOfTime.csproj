<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PulseOfTime</AssemblyName>
    <RootNamespace>PulseOfTime</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Pulse of Time</Product>
    <Description>PS5-style haptics, adaptive triggers and lights for Ocarina of Time (Switch 2) in the Lichii emulator</Description>
    <Copyright>Copyright (C) 2026 Pulse of Time contributors, GPL-3.0-or-later</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
